node_modules/
dist/
.env
.env.local
*.log
.DS_Store

# v0.74 — Type A visual-regression harness output (scripts/visual-regression.mjs).
# Baseline/current/diff screenshots are local measurement artifacts.
.visual-regression/

# v0.07: customer-managed artwork content. Originals and generated files
# stay local on the customer machine; only the empty inbox/processed
# folders are committed (via .gitkeep).
# v0.75: inbox source files (images, .txt sidecars, audio) are now tracked
# so that CI can run the importer and deploy to GitHub Pages.
customer-artworks/processed/*
!customer-artworks/processed/.gitkeep
customer-artworks/artworks.json
customer-artworks/artworks.json.bak
customer-artworks/last-import-report.txt
customer-preview/images/
customer-preview/customer-artworks.js
customer-preview/customer-audio.js

# v0.75: public/ files generated by `npm run import:artworks` (sync-customer-public.mjs).
# These are rebuilt by CI from the committed inbox sources; do not commit them.
public/images/
public/audio/
public/customer-artworks.js
public/customer-audio.js
