{
  "name": "freyraum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open app.html",
    "editor": "vite --open placement-editor.html",
    "import:artworks": "node scripts/import-artworks.mjs && node scripts/sync-customer-public.mjs",
    "prebuild": "npm run import:artworks",
    "build": "npm run build:typecheck && vite build && npm run build:preview && npm run build:preview-html",
    "preview": "vite preview --outDir customer-preview --open app.html",
    "lint": "eslint src worker/src desktop/src scripts/local-project --ext ts",
    "format": "prettier --write src",
    "build:typecheck": "tsc",
    "build:preview": "vite build --config vite.local.config.ts",
    "build:preview-html": "node scripts/write-local-preview.mjs",
    "test:frame-budget": "node scripts/test-frame-budget.mjs",
    "test:front-wall-aspect": "node scripts/test-front-wall-aspect.mjs",
    "test:gallery-room-view": "node scripts/test-gallery-room-view.mjs",
    "test:gallery-room-view:browser": "node scripts/test-gallery-room-view-browser.mjs",
    "diagnose:artwork-aspect": "node scripts/diagnose-artwork-aspect.mjs",
    "test:webgl-resilience": "node scripts/test-webgl-resilience.mjs",
    "validate:museum-hub": "node scripts/test-museum-hub-geometry.mjs",
    "test:editor-drag": "node scripts/test-editor-drag.mjs",
    "test:editor-rooms": "node scripts/test-editor-rooms.mjs",
    "test:editor-publish": "node scripts/test-editor-publish.mjs",
    "test:save-service": "node scripts/test-save-service.mjs",
    "test:validate-deploy": "node scripts/test-validate-deploy.mjs",
    "test:local-project": "node scripts/test-local-project.mjs",
    "test:desktop-app": "node scripts/test-desktop-app.mjs",
    "smoke:desktop-package": "node scripts/smoke-desktop-package.mjs",
    "test:deploy-smoke": "node scripts/test-deploy-smoke.mjs",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "validate:museum-hub:visual": "node scripts/visual-regression.mjs compare",
    "validate:visual": "node scripts/visual-regression.mjs",
    "docs:check-config-authority": "node scripts/check-config-doc-authority.mjs"
  },
  "dependencies": {
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
